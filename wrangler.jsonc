{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Worker for cricket.hillrisers.co.uk, built with OpenNext (@opennextjs/cloudflare)
  "name": "hillriserscricketacademy",
  // OpenNext's worker plus the daily balance-reminder cron
  "main": "custom-worker.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Must match "name" above
      "binding": "WORKER_SELF_REFERENCE",
      "service": "hillriserscricketacademy"
    }
  ],
  // Registrations, coach interest etc. Created automatically on first deploy if it doesn't exist.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hillrisers"
    }
  ],
  // Keep variables set in the Cloudflare dashboard (ADMIN_PASSWORD etc.) on each deploy
  "keep_vars": true,
  // Partner balance reminders: 07:00 and 08:00 UTC = 8am UK in BST and GMT (the run before 8am sends nothing)
  "triggers": {
    "crons": ["0 7 * * *", "0 8 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
