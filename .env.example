# Public site URL (canonical URLs, metadata, links in emails). Defaults to the
# Vercel production URL, then https://hillriserscricketacademytest.vercel.app
NEXT_PUBLIC_SITE_URL=

# Stripe — leave blank in development to use the built-in test checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional: a single £25 Price for "HillRisers Cricket Academy Session".
# If blank, Checkout uses inline price_data built from the session's pricePence.
STRIPE_ACADEMY_PRICE_ID=

# PostgreSQL / Supabase connection string. If blank, bookings are stored in
# a local JSON file (.data/store.json) — fine for development, not for production.
DATABASE_URL=

# Admin area (/admin/bookings) — HTTP Basic auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Transactional email (optional). If blank, emails are logged to the console.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "HillRisers <hello@yourdomain>"
EMAIL_FROM=
# Where new registrations, coach applications and enquiries are emailed
ACADEMY_NOTIFY_EMAIL=
